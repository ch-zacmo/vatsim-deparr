<div class="board departures-board standalone">
  <div class="board-header">
    <h2>DEPARTURES - <%= airportName %> (<%= icao %>)</h2>
    <span class="update-time" id="depUpdateTime"></span>
  </div>
  <div class="board-content">
    <table class="fids-table">
      <thead>
        <tr>
          <th>TIME</th>
          <th>FLIGHT</th>
          <th>DESTINATION</th>
          <th>AIRCRAFT</th>
          <th>GATE</th>
          <th>STATUS</th>
        </tr>
      </thead>
      <tbody id="departuresBody">
        <tr><td colspan="6" class="loading">Loading...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  window.PAGE_TYPE = 'departures';
  window.AIRPORT_ICAO = '<%= icao %>';
</script>

<div class="embed-both">
  <div class="row boards-container">
    <div class="col-md-6">
      <div class="board departures-board">
        <div class="board-header">
          <h2>DEPARTURES - <%= icao %></h2>
          <span class="update-time" id="depUpdateTime"></span>
        </div>
        <div class="board-content">
          <table class="fids-table">
            <thead>
              <tr>
                <th>TIME</th>
                <th>FLIGHT</th>
                <th>DESTINATION</th>
                <th>AIRCRAFT</th>
                <th>GATE</th>
                <th>STATUS</th>
              </tr>
            </thead>
            <tbody id="departuresBody">
              <tr><td colspan="6" class="loading">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="board arrivals-board">
        <div class="board-header">
          <h2>ARRIVALS - <%= icao %></h2>
          <span class="update-time" id="arrUpdateTime"></span>
        </div>
        <div class="board-content">
          <table class="fids-table">
            <thead>
              <tr>
                <th>TIME</th>
                <th>FLIGHT</th>
                <th>ORIGIN</th>
                <th>AIRCRAFT</th>
                <th>GATE</th>
                <th>STATUS</th>
              </tr>
            </thead>
            <tbody id="arrivalsBody">
              <tr><td colspan="6" class="loading">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<script>
  window.PAGE_TYPE = 'airport';
  window.AIRPORT_ICAO = '<%= icao %>';
</script>

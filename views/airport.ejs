<div class="airport-header">
  <h1>
    <span class="airport-code"><%= icao %></span>
    <% if (iata) { %><span class="airport-iata">(<%= iata %>)</span><% } %>
    <span class="airport-name"><%= airportName %></span>
  </h1>

  <div class="embed-buttons">
    <button class="btn btn-sm btn-outline-light" data-embed-type="departures">
      Embed Departures
    </button>
    <button class="btn btn-sm btn-outline-light" data-embed-type="arrivals">
      Embed Arrivals
    </button>
    <button class="btn btn-sm btn-outline-light" data-embed-type="both">
      Embed Both
    </button>
  </div>
</div>

<div class="row boards-container">
  <div class="col-lg-6">
    <div class="board departures-board">
      <div class="board-header">
        <h2>DEPARTURES</h2>
        <span class="update-time" id="depUpdateTime"></span>
      </div>
      <div class="board-content">
        <table class="fids-table">
          <thead>
            <tr>
              <th>TIME</th>
              <th>FLIGHT</th>
              <th>DESTINATION</th>
              <th>AIRCRAFT</th>
              <th>GATE</th>
              <th>STATUS</th>
            </tr>
          </thead>
          <tbody id="departuresBody">
            <tr><td colspan="6" class="loading">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="board arrivals-board">
      <div class="board-header">
        <h2>ARRIVALS</h2>
        <span class="update-time" id="arrUpdateTime"></span>
      </div>
      <div class="board-content">
        <table class="fids-table">
          <thead>
            <tr>
              <th>TIME</th>
              <th>FLIGHT</th>
              <th>ORIGIN</th>
              <th>AIRCRAFT</th>
              <th>GATE</th>
              <th>STATUS</th>
            </tr>
          </thead>
          <tbody id="arrivalsBody">
            <tr><td colspan="6" class="loading">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Embed Modal -->
<div class="modal fade" id="embedModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Embed Code</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Copy this code to embed on your website:</p>
        <textarea id="embedCode" class="form-control" rows="4" readonly></textarea>
        <button class="btn btn-primary mt-2" id="copyEmbedBtn">Copy to Clipboard</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  window.PAGE_TYPE = 'airport';
  window.AIRPORT_ICAO = '<%= icao %>';

  document.addEventListener('DOMContentLoaded', function() {
    function showEmbed(type) {
      const baseUrl = window.location.origin;
      let url, width = '100%', height = '500px';

      if (type === 'departures') {
        url = `${baseUrl}/departures/<%= icao %>`;
      } else if (type === 'arrivals') {
        url = `${baseUrl}/arrivals/<%= icao %>`;
      } else {
        url = `${baseUrl}/embed/<%= icao %>`;
        height = '700px';
      }

      const code = `<iframe src="${url}" width="${width}" height="${height}" frameborder="0"></iframe>`;
      document.getElementById('embedCode').value = code;

      const modal = new bootstrap.Modal(document.getElementById('embedModal'));
      modal.show();
    }

    function copyEmbed() {
      const textarea = document.getElementById('embedCode');
      textarea.select();
      document.execCommand('copy');
      alert('Copied to clipboard!');
    }

    // Attach event listeners for embed buttons
    document.querySelectorAll('[data-embed-type]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        showEmbed(this.dataset.embedType);
      });
    });

    // Attach event listener for copy button
    document.getElementById('copyEmbedBtn').addEventListener('click', copyEmbed);
  });
</script>
